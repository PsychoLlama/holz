{
  "name": "@holz/json-backend",
  "version": "0.9.1",
  "description": "Print logs as newline-delimited JSON.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/PsychoLlama/holz",
    "directory": "packages/holz-json-backend"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/holz-json-backend.d.ts",
      "default": "./dist/holz-json-backend.js"
    },
    "./marshal": {
      "source": "./src/marshal/index.ts",
      "types": "./dist/marshal.d.ts",
      "default": "./dist/marshal.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "timeout": 60000
  },
  "author": "Jesse Gibson",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__"
  ],
  "keywords": [
    "holz-backend",
    "ndjson",
    "structured",
    "logging"
  ],
  "scripts": {
    "prepack": "vite build",
    "test:unit": "vitest run --color --passWithNoTests",
    "test:coverage": "vitest run --coverage --color --passWithNoTests",
    "test:types": "tsc"
  },
  "peerDependencies": {
    "@holz/core": "^0.9.0"
  },
  "devDependencies": {
    "@holz/core": "workspace:^",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "rolldown-plugin-dts": "^0.28.8",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
