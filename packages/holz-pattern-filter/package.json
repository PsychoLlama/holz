{
  "name": "@holz/pattern-filter",
  "version": "0.9.1",
  "description": "Only print log messages that match a pattern",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/PsychoLlama/holz",
    "directory": "packages/holz-pattern-filter"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/holz-pattern-filter.d.ts",
      "default": "./dist/holz-pattern-filter.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Jesse Gibson",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__"
  ],
  "keywords": [
    "holz",
    "logger",
    "filter",
    "pattern",
    "exclude"
  ],
  "scripts": {
    "prepack": "vite build",
    "test:unit": "vitest run --color --passWithNoTests",
    "test:coverage": "vitest run --coverage --color --passWithNoTests",
    "test:types": "tsc"
  },
  "peerDependencies": {
    "@holz/core": "^0.8.0 || ^0.9.0"
  },
  "devDependencies": {
    "@holz/core": "workspace:^",
    "@vitest/coverage-v8": "^5.0.0",
    "rolldown-plugin-dts": "^0.28.8",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
