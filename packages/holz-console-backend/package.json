{
  "name": "@holz/console-backend",
  "version": "0.10.0",
  "description": "A console backend for Holz",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/PsychoLlama/holz",
    "directory": "packages/holz-console-backend"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/holz-console-backend.d.ts",
      "default": "./dist/holz-console-backend.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "timeout": 60000
  },
  "author": "Jesse Gibson",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__"
  ],
  "keywords": [
    "holz-backend",
    "console",
    "browser",
    "debugger"
  ],
  "scripts": {
    "prepack": "vite build",
    "test:unit": "vitest run --color --passWithNoTests",
    "test:coverage": "vitest run --coverage --color --passWithNoTests",
    "test:types": "tsc"
  },
  "peerDependencies": {
    "@holz/core": "^0.8.0 || ^0.9.0 || ^0.10.0"
  },
  "devDependencies": {
    "@holz/core": "workspace:^",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "rolldown-plugin-dts": "^0.29.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
