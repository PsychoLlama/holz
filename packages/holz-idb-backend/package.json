{
  "name": "@holz/idb-backend",
  "version": "0.11.1",
  "description": "Persist logs to IndexedDB.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/PsychoLlama/holz",
    "directory": "packages/holz-idb-backend"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/holz-idb-backend.d.ts",
      "default": "./dist/holz-idb-backend.js"
    },
    "./database": {
      "source": "./src/database/external.ts",
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "timeout": 60000
  },
  "author": "Jesse Gibson",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__"
  ],
  "keywords": [
    "holz-backend",
    "indexeddb",
    "structured",
    "logging"
  ],
  "scripts": {
    "prepack": "vite build",
    "test:unit": "vitest run --color --passWithNoTests",
    "test:coverage": "vitest run --coverage --color --passWithNoTests",
    "test:types": "tsc"
  },
  "peerDependencies": {
    "@holz/core": "^0.11.0"
  },
  "devDependencies": {
    "@holz/core": "workspace:^",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "playwright": "^1.65.0",
    "rolldown-plugin-dts": "^0.30.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
