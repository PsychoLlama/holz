{
  "name": "@holz/logger",
  "version": "0.9.1",
  "description": "A preconfigured, general-purpose logger",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/PsychoLlama/holz",
    "directory": "packages/holz-logger"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#processor": {
      "source": {
        "browser": "./src/processor.browser.ts",
        "default": "./src/processor.node.ts"
      },
      "browser": "./dist/processor.browser.js",
      "default": "./dist/processor.node.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "timeout": 60000
  },
  "author": "Jesse Gibson",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__"
  ],
  "keywords": [
    "holz",
    "logger",
    "preconfigured",
    "browser",
    "node",
    "deno"
  ],
  "scripts": {
    "prepack": "vite build",
    "test:unit": "vitest run --color --passWithNoTests",
    "test:coverage": "vitest run --coverage --color --passWithNoTests",
    "test:types": "tsc"
  },
  "dependencies": {
    "@holz/ansi-terminal-backend": "workspace:^",
    "@holz/console-backend": "workspace:^",
    "@holz/core": "workspace:^",
    "@holz/env-filter": "workspace:^",
    "@holz/log-collector": "workspace:^",
    "@holz/stream-backend": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "rolldown-plugin-dts": "^0.28.8",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
