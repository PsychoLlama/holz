{
  "name": "@holz/core",
  "version": "0.10.0",
  "description": "A structured and composable logger",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/PsychoLlama/holz",
    "directory": "packages/holz-core"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/holz-core.d.ts",
      "default": "./dist/holz-core.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "timeout": 60000
  },
  "author": "Jesse Gibson",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__"
  ],
  "keywords": [
    "structured",
    "composable",
    "logger"
  ],
  "scripts": {
    "prepack": "vite build",
    "test:unit": "vitest run --color --passWithNoTests",
    "test:coverage": "vitest run --coverage --color --passWithNoTests",
    "test:types": "tsc"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "rolldown-plugin-dts": "^0.28.8",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
